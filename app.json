{
  "expo": {
    "name": "Hayat",
    "slug": "hayat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.hayat.music"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-image",
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "projectName": "Hayat",
      "EXPO_PUBLIC_CHARTS_API_URL": "http://127.0.0.1:5000",
      "EXPO_PUBLIC_STREAMING_API_URL": "http://127.0.0.1:5000",
      "EXPO_PUBLIC_JIOSAAVN_API_URL": "http://127.0.0.1:5000"
    }
  }
}
